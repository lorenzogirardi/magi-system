+++ b/app/toolbox/tools/text_diff.py
@@ -0,0 +1,79 @@
+"""Tool ``text.diff`` - unified diff between two strings."""
+
+from __future__ import annotations
+
+import difflib
+
+from pydantic import BaseModel, Field
+
+from app.toolbox.base import (
+    Outcome,
+    ToolLimitExceeded,
+    ToolResult,
+    ToolboxLimits,
+    check_text_size,
+)
+
+
+class TextDiffInput(BaseModel):
+    """Input of ``text.diff``."""
+
+    left: str = Field(..., description="Original text.")
+    right: str = Field(..., description="Modified text.")
+    context_lines: int = Field(
+        default=3,
+        ge=0,
+        description=(
+            "Number of context lines around each change. Bounded by "
+            "TOOLBOX_MAX_DIFF_CONTEXT_LINES; a larger value is rejected, never truncated."
+        ),
+    )
+
+
+class TextDiffTool:
+    """Return a unified diff between two strings."""
+
+    name = "text.diff"
+    version = "1.0.0"
+    description = (
+        "Return a unified diff between two strings. The number of context lines is configurable "
+        "within the configured maximum."
+    )
+    input_model = TextDiffInput
+
+    def execute(self, params: TextDiffInput, limits: ToolboxLimits) -> ToolResult:
+        check_text_size(params.left, limits, field_name="left")
+        check_text_size(params.right, limits, field_name="right")
+
+        if params.context_lines > limits.max_diff_context_lines:
+            raise ToolLimitExceeded(
+                f"context_lines={params.context_lines} exceeds the configured maximum of "
+                f"{limits.max_diff_context_lines}",
+                limit="max_diff_context_lines",
+                value=limits.max_diff_context_lines,
+            )
+
+        diff_lines = list(
+            difflib.unified_diff(
+                params.left.splitlines(),
+                params.right.splitlines(),
+                fromfile="left",
+                tofile="right",
+                n=params.context_lines,
+                lineterm="",
+            )
+        )
+        identical = not diff_lines
+
+        return ToolResult(
+            outcome=Outcome.PASS if identical else Outcome.FAIL,
+            findings=[],
+            output={
+                "identical": identical,
+                "context_lines": params.context_lines,
+                "diff": "\n".join(diff_lines),
+            },
+        )
+
+
+TOOL = TextDiffTool()
