index 0000000..6c756f4
--- /dev/null
+++ b/app/toolbox/registry.py
@@ -0,0 +1,40 @@
+"""Explicit registry of the available toolbox tools.
+
+The registry is a plain dictionary populated at import time from a static list
+of modules. There is no dynamic import, no ``eval``/``exec`` and no shell: a
+client can never make the process load or run anything.
+"""
+
+from __future__ import annotations
+
+from app.toolbox.base import Tool
+from app.toolbox.tools import json_validate, k8s_manifest_inspect, text_diff
+
+_REGISTRY: dict[str, Tool] = {}
+
+
+def register(tool: Tool) -> None:
+    """Register a tool. Raises ValueError on an empty or duplicate identifier."""
+    if not tool.name:
+        raise ValueError("tool name must not be empty")
+    if tool.name in _REGISTRY:
+        raise ValueError(f"duplicate tool name: {tool.name}")
+    _REGISTRY[tool.name] = tool
+
+
+def get_tool(name: str) -> Tool | None:
+    """Return the tool with this identifier, or None when it is unknown."""
+    return _REGISTRY.get(name)
+
+
+def list_tools() -> list[Tool]:
+    """Return the registered tools sorted by identifier (deterministic order)."""
+    return [_REGISTRY[name] for name in sorted(_REGISTRY)]
+
+
+def _register_builtin_tools() -> None:
+    for tool in (json_validate.TOOL, text_diff.TOOL, k8s_manifest_inspect.TOOL):
+        register(tool)
+
+
+_register_builtin_tools()
