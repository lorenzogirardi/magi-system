+"""Unit tests for the text.diff tool (framework-independent)."""
+
+import pytest
+
+from app.toolbox.base import Outcome, ToolLimitExceeded, ToolboxLimits
+from app.toolbox.tools.text_diff import TOOL, TextDiffInput
+
+
+def _limits(**overrides) -> ToolboxLimits:
+    base = dict(
+        max_input_bytes=262_144,
+        max_yaml_documents=50,
+        max_yaml_depth=32,
+        max_findings=200,
+        max_diff_context_lines=10,
+    )
+    base.update(overrides)
+    return ToolboxLimits(**base)
+
+
+def _run(left: str, right: str, context_lines: int = 3, **overrides):
+    return TOOL.execute(
+        TextDiffInput(left=left, right=right, context_lines=context_lines),
+        _limits(**overrides),
+    )
+
+
+def test_identical_strings_pass_with_empty_diff():
+    result = _run("a\nb\n", "a\nb\n")
+    assert result.outcome is Outcome.PASS
+    assert result.output["identical"] is True
+    assert result.output["diff"] == ""
+
+
+def test_changed_strings_produce_a_unified_diff():
+    result = _run("a\nb\nc\n", "a\nB\nc\n")
+    assert result.outcome is Outcome.FAIL
+    assert result.output["identical"] is False
+    diff = result.output["diff"]
+    assert diff.startswith("--- left")
+    assert "+++ right" in diff
+    assert "-b" in diff
+    assert "+B" in diff
+
+
+def test_empty_inputs_are_identical():
+    result = _run("", "")
+    assert result.outcome is Outcome.PASS
+    assert result.output["identical"] is True
+
+
+def test_empty_left_against_non_empty_right():
+    result = _run("", "x\n")
+    assert result.outcome is Outcome.FAIL
+    assert "+x" in result.output["diff"]
+
+
+def test_context_lines_zero_is_allowed():
+    result = _run("a\nb\nc\n", "a\nB\nc\n", context_lines=0)
+    assert result.output["context_lines"] == 0
+
+
+def test_context_lines_above_the_limit_is_rejected():
+    with pytest.raises(ToolLimitExceeded) as exc:
+        _run("a\n", "b\n", context_lines=11, max_diff_context_lines=10)
+    assert exc.value.limit == "max_diff_context_lines"
+
+
+def test_oversized_left_is_rejected():
+    with pytest.raises(ToolLimitExceeded) as exc:
+        _run("x" * 100, "y", max_input_bytes=10)
+    assert exc.value.limit == "max_input_bytes"
+
+
+def test_oversized_right_is_rejected():
+    with pytest.raises(ToolLimitExceeded) as exc:
+        _run("y", "x" * 100, max_input_bytes=10)
+    assert exc.value.limit == "max_input_bytes"
+
+
+def test_output_is_deterministic():
+    first = _run("a\nb\n", "a\nc\n")
+    second = _run("a\nb\n", "a\nc\n")
+    assert first.outcome == second.outcome
+    assert first.output == second.output
