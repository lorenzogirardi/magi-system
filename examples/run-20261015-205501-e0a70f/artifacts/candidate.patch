+"""Unit tests for the json.validate tool (framework-independent)."""
+
+import pytest
+
+from app.toolbox.base import Outcome, ToolLimitExceeded, ToolboxLimits
+from app.toolbox.tools.json_validate import TOOL, JsonValidateInput
+
+
+def _limits(**overrides) -> ToolboxLimits:
+    base = dict(
+        max_input_bytes=262_144,
+        max_yaml_documents=50,
+        max_yaml_depth=32,
+        max_findings=200,
+        max_diff_context_lines=10,
+    )
+    base.update(overrides)
+    return ToolboxLimits(**base)
+
+
+def _run(text: str, **overrides):
+    return TOOL.execute(JsonValidateInput(text=text), _limits(**overrides))
+
+
+def test_valid_object_returns_parsed_value():
+    result = _run('{"a": 1, "b": [true, null]}')
+    assert result.outcome is Outcome.PASS
+    assert result.findings == []
+    assert result.output["valid"] is True
+    assert result.output["value"] == {"a": 1, "b": [True, None]}
+
+
+def test_valid_scalar_is_accepted():
+    result = _run("42")
+    assert result.outcome is Outcome.PASS
+    assert result.output["value"] == 42
+
+
+def test_invalid_json_reports_position():
+    result = _run('{"a": }')
+    assert result.outcome is Outcome.FAIL
+    assert result.output["valid"] is False
+    assert result.output["line"] == 1
+    assert result.output["column"] >= 1
+    assert result.findings[0].code == "JSON_INVALID"
+    assert result.findings[0].severity.value == "error"
+
+
+def test_empty_input_is_invalid_not_an_exception():
+    result = _run("")
+    assert result.outcome is Outcome.FAIL
+    assert result.output["valid"] is False
+    assert result.findings[0].code == "JSON_INVALID"
+
+
+def test_whitespace_only_input_is_invalid():
+    result = _run("   \n  ")
+    assert result.outcome is Outcome.FAIL
+
+
+def test_url_like_string_is_treated_as_text_not_fetched():
+    result = _run("https://example.com/data.json")
+    assert result.outcome is Outcome.FAIL
+    assert result.output["valid"] is False
+
+
+def test_path_like_string_is_treated_as_text_not_opened():
+    result = _run("/etc/passwd")
+    assert result.outcome is Outcome.FAIL
+    assert result.output["valid"] is False
+
+
+def test_oversized_input_is_rejected_with_a_controlled_error():
+    with pytest.raises(ToolLimitExceeded) as exc:
+        _run("x" * 100, max_input_bytes=10)
+    assert exc.value.limit == "max_input_bytes"
+
+
+def test_output_is_deterministic():
+    first = _run('{"a": 1}')
+    second = _run('{"a": 1}')
+    assert first.outcome == second.outcome
+    assert first.output == second.output
+    assert first.findings == second.findings
+
+
+def test_invalid_output_is_deterministic():
+    first = _run('{"a": }')
+    second = _run('{"a": }')
+    assert first.output == second.output
+    assert first.findings == second.findings
