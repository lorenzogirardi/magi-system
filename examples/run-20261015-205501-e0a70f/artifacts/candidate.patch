--- /dev/null
+++ b/app/toolbox/tools/json_validate.py
@@ -0,0 +1,72 @@
+"""Tool ``json.validate`` - syntactic validation of a JSON document."""
+
+from __future__ import annotations
+
+import json
+
+from pydantic import BaseModel, Field
+
+from app.toolbox.base import (
+    Finding,
+    FindingLocation,
+    Outcome,
+    Severity,
+    ToolResult,
+    ToolboxLimits,
+    check_text_size,
+)
+
+
+class JsonValidateInput(BaseModel):
+    """Input of ``json.validate``.
+
+    ``text`` is always treated as literal JSON text: URLs and file paths are
+    never resolved, fetched or opened.
+    """
+
+    text: str = Field(..., description="JSON document as text. URLs and file paths are not resolved.")
+
+
+class JsonValidateTool:
+    """Validate syntax and return the parsed value or the error position."""
+
+    name = "json.validate"
+    version = "1.0.0"
+    description = (
+        "Validate the syntax of a JSON document supplied as text and return the parsed value, "
+        "or an error with the position of the first syntax problem. URLs and file paths are not accepted."
+    )
+    input_model = JsonValidateInput
+
+    def execute(self, params: JsonValidateInput, limits: ToolboxLimits) -> ToolResult:
+        check_text_size(params.text, limits, field_name="text")
+
+        try:
+            value = json.loads(params.text)
+        except json.JSONDecodeError as exc:
+            finding = Finding(
+                code="JSON_INVALID",
+                severity=Severity.ERROR,
+                message=f"Invalid JSON: {exc.msg}",
+                location=FindingLocation(path=f"line {exc.lineno}, column {exc.colno}"),
+                suggestion="Fix the syntax at the reported line and column and run the tool again.",
+            )
+            return ToolResult(
+                outcome=Outcome.FAIL,
+                findings=[finding],
+                output={
+                    "valid": False,
+                    "line": exc.lineno,
+                    "column": exc.colno,
+                    "position": exc.pos,
+                },
+            )
+
+        return ToolResult(
+            outcome=Outcome.PASS,
+            findings=[],
+            output={"valid": True, "value": value},
+        )
+
+
+TOOL = JsonValidateTool()
diff --git a/app/toolbox/tools/k8s_manifest_inspect.py b/app/toolbox/tools/k8s_manifest_inspect.py
new file mode 100644
index 0000000..39313fd
--- /dev/null
+++ b/app/toolbox/tools/k8s_manifest_inspect.py
@@ -0,0 +1,473 @@
+"""Tool ``k8s.manifest.inspect`` - static, offline checks on Kubernetes manifests.
+
+The checks are deliberately narrow: they are NOT a complete Kubernetes
+validation and NOT a security certification. They never contact a cluster and
+never read a file or a URL.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import yaml
+from pydantic import BaseModel, Field
+
+from app.toolbox.base import (
+    Finding,
+    FindingLocation,
+    Outcome,
+    Severity,
+    ToolLimitExceeded,
+    ToolResult,
+    ToolboxLimits,
+    check_text_size,
+)
+
+SUPPORTED_KINDS = ("Deployment", "StatefulSet", "DaemonSet")
+
+FINDINGS_LIMIT_CODE = "TOOLBOX_FINDINGS_LIMIT_EXCEEDED"
+
+DISCLAIMER = (
+    "Static, offline checks only. This is not a complete Kubernetes validation "
+    "and not a security certification."
+)
+
+
+class K8sManifestInspectInput(BaseModel):
+    """Input of ``k8s.manifest.inspect``."""
+
+    manifest: str = Field(..., description="Kubernetes YAML manifest, possibly multi-document.")
+
+
+class _NoAliasSafeLoader(yaml.SafeLoader):
+    """SafeLoader that refuses YAML aliases.
+
+    Aliases make it possible to build a small document that expands to a huge
+    object graph (a "billion laughs" bomb). The toolbox never needs them, so
+    they are rejected instead of being expanded.
+    """
+
+    def compose_node(self, parent, index):  # type: ignore[no-untyped-def]
+        if self.check_event(yaml.events.AliasEvent):
+            event = self.peek_event()
+            raise yaml.constructor.ConstructorError(
+                None,
+                None,
+                "YAML aliases are not supported by this tool",
+                event.start_mark,
+            )
+        return super().compose_node(parent, index)
+
+
+def _max_depth(value: Any, current: int = 0) -> int:
+    """Maximum nesting depth of a parsed YAML value."""
+    if isinstance(value, dict):
+        if not value:
+            return current
+        return max(_max_depth(item, current + 1) for item in value.values())
+    if isinstance(value, list):
+        if not value:
+            return current
+        return max(_max_depth(item, current + 1) for item in value)
+    return current
+
+
+def _pod_spec(document: dict) -> dict | None:
+    """Return ``spec.template.spec`` of a workload, or None when it is absent."""
+    spec = document.get("spec")
+    if not isinstance(spec, dict):
+        return None
+    template = spec.get("template")
+    if not isinstance(template, dict):
+        return None
+    pod_spec = template.get("spec")
+    if not isinstance(pod_spec, dict):
+        return None
+    return pod_spec
+
+
+def _resource_name(document: dict) -> str | None:
+    metadata = document.get("metadata")
+    if not isinstance(metadata, dict):
+        return None
+    name = metadata.get("name")
+    return name if isinstance(name, str) and name else None
+
+
+class K8sManifestInspectTool:
+    """Inspect Deployment / StatefulSet / DaemonSet manifests without a cluster."""
+
+    name = "k8s.manifest.inspect"
+    version = "1.0.0"
+    description = (
+        "Run static, offline checks on a Kubernetes YAML manifest (multi-document supported) "
+        "for Deployment, StatefulSet and DaemonSet: resource requests/limits, probes, image tags, "
+        "privileged containers, privilege escalation and non-root execution. "
+        "Not a complete Kubernetes validation and not a security certification."
+    )
+    input_model = K8sManifestInspectInput
+
+    def execute(self, params: K8sManifestInspectInput, limits: ToolboxLimits) -> ToolResult:
+        check_text_size(params.manifest, limits, field_name="manifest")
+
+        try:
+            documents = list(yaml.load_all(params.manifest, Loader=_NoAliasSafeLoader))
+        except yaml.YAMLError as exc:
+            return ToolResult(
+                outcome=Outcome.FAIL,
+                findings=[
+                    Finding(
+                        code="K8S_YAML_INVALID",
+                        severity=Severity.ERROR,
+                        message=f"Invalid YAML: {exc}",
+                        location=FindingLocation(path="manifest"),
+                        suggestion="Fix the YAML syntax and run the tool again.",
+                    )
+                ],
+                output={"valid_yaml": False, "documents": 0, "disclaimer": DISCLAIMER},
+            )
+        except RecursionError:
+            raise ToolLimitExceeded(
+                "manifest nesting is too deep to parse safely",
+                limit="max_yaml_depth",
+                value=limits.max_yaml_depth,
+            ) from None
+
+        if len(documents) > limits.max_yaml_documents:
+            raise ToolLimitExceeded(
+                f"manifest contains {len(documents)} YAML documents, which exceeds the configured "
+                f"maximum of {limits.max_yaml_documents}",
+                limit="max_yaml_documents",
+                value=limits.max_yaml_documents,
+            )
+
+        findings: list[Finding] = []
+        inspected = 0
+
+        for index, document in enumerate(documents):
+            if document is None:
+                continue
+            try:
+                depth = _max_depth(document)
+            except RecursionError:
+                raise ToolLimitExceeded(
+                    f"document {index} nests too deeply to inspect safely",
+                    limit="max_yaml_depth",
+                    value=limits.max_yaml_depth,
+                ) from None
+            if depth > limits.max_yaml_depth:
+                raise ToolLimitExceeded(
+                    f"document {index} nests {depth} levels, which exceeds the configured maximum "
+                    f"of {limits.max_yaml_depth}",
+                    limit="max_yaml_depth",
+                    value=limits.max_yaml_depth,
+                )
+            if not isinstance(document, dict):
+                findings.append(
+                    Finding(
+                        code="K8S_DOCUMENT_NOT_A_MAPPING",
+                        severity=Severity.WARNING,
+                        message="The YAML document is not a mapping and cannot be inspected as a Kubernetes resource.",
+                        location=FindingLocation(document_index=index),
+                        suggestion="Provide a Kubernetes resource as a YAML mapping.",
+                    )
+                )
+                continue
+            findings.extend(self._inspect_document(document, index))
+            inspected += 1
+
+        total = len(findings)
+        limit_exceeded = total > limits.max_findings
+        if limit_exceeded:
+            keep = max(0, limits.max_findings - 1)
+            findings = findings[:keep]
+            findings.append(
+                Finding(
+                    code=FINDINGS_LIMIT_CODE,
+                    severity=Severity.ERROR,
+                    message=(
+                        f"The analysis produced {total} findings, which exceeds the configured maximum of "
+                        f"{limits.max_findings}. The list is truncated to the first {keep} findings plus "
+                        "this notice; nothing is dropped silently."
+                    ),
+                    suggestion="Narrow the manifest or raise TOOLBOX_MAX_FINDINGS.",
+                )
+            )
+
+        if limit_exceeded:
+            outcome = Outcome.ERROR
+        elif any(f.severity in (Severity.WARNING, Severity.ERROR) for f in findings):
+            outcome = Outcome.FAIL
+        else:
+            outcome = Outcome.PASS
+
+        return ToolResult(
+            outcome=outcome,
+            findings=findings,
+            output={
+                "documents": len(documents),
+                "resources_inspected": inspected,
+                "supported_kinds": list(SUPPORTED_KINDS),
+                "limit_exceeded": limit_exceeded,
+                "findings_total": total,
+                "findings_returned": len(findings),
+                "disclaimer": DISCLAIMER,
+            },
+        )
+
+    # --- per document -------------------------------------------------
+
+    def _inspect_document(self, document: dict, index: int) -> list[Finding]:
+        kind = document.get("kind")
+        name = _resource_name(document)
+
+        if not isinstance(kind, str) or not kind:
+            return [
+                Finding(
+                    code="K8S_MISSING_KIND",
+                    severity=Severity.WARNING,
+                    message="The document has no 'kind' field, so it cannot be inspected.",
+                    location=FindingLocation(document_index=index, resource_name=name, path="kind"),
+                    suggestion="Add the 'kind' field of the Kubernetes resource.",
+                )
+            ]
+
+        if kind not in SUPPORTED_KINDS:
+            return [
+                Finding(
+                    code="K8S_UNSUPPORTED_KIND",
+                    severity=Severity.INFO,
+                    message=f"Kind '{kind}' is not inspected by this tool.",
+                    location=FindingLocation(
+                        document_index=index, resource_kind=kind, resource_name=name, path="kind"
+                    ),
+                    suggestion=f"Supported kinds: {', '.join(SUPPORTED_KINDS)}.",
+                )
+            ]
+
+        pod_spec = _pod_spec(document)
+        if pod_spec is None:
+            return [
+                Finding(
+                    code="K8S_MISSING_POD_SPEC",
+                    severity=Severity.WARNING,
+                    message=f"{kind} '{name or '<unnamed>'}' has no spec.template.spec to inspect.",
+                    location=FindingLocation(
+                        document_index=index,
+                        resource_kind=kind,
+                        resource_name=name,
+                        path="spec.template.spec",
+                    ),
+                    suggestion="Provide a workload template with a pod spec.",
+                )
+            ]
+
+        findings: list[Finding] = []
+
+        pod_security = pod_spec.get("securityContext")
+        pod_security = pod_security if isinstance(pod_security, dict) else {}
+        pod_run_as_non_root = pod_security.get("runAsNonRoot") is True
+
+        containers = pod_spec.get("containers")
+        if not isinstance(containers, list) or not containers:
+            findings.append(
+                Finding(
+                    code="K8S_NO_CONTAINERS",
+                    severity=Severity.WARNING,
+                    message=f"{kind} '{name or '<unnamed>'}' declares no containers.",
+                    location=FindingLocation(
+                        document_index=index,
+                        resource_kind=kind,
+                        resource_name=name,
+                        path="spec.template.spec.containers",
+                    ),
+                    suggestion="Declare at least one container.",
+                )
+            )
+        else:
+            for position, container in enumerate(containers):
+                findings.extend(
+                    self._inspect_container(
+                        container,
+                        index,
+                        kind,
+                        name,
+                        f"spec.template.spec.containers[{position}]",
+                        pod_run_as_non_root,
+                        is_init=False,
+                    )
+                )
+
+        init_containers = pod_spec.get("initContainers")
+        if isinstance(init_containers, list):
+            for position, container in enumerate(init_containers):
+                findings.extend(
+                    self._inspect_container(
+                        container,
+                        index,
+                        kind,
+                        name,
+                        f"spec.template.spec.initContainers[{position}]",
+                        pod_run_as_non_root,
+                        is_init=True,
+                    )
+                )
+
+        return findings
+
+    # --- per container ------------------------------------------------
+
+    def _inspect_container(
+        self,
+        container: Any,
+        index: int,
+        kind: str,
+        name: str | None,
+        base_path: str,
+        pod_run_as_non_root: bool,
+        *,
+        is_init: bool,
+    ) -> list[Finding]:
+        if not isinstance(container, dict):
+            return [
+                Finding(
+                    code="K8S_INVALID_CONTAINER",
+                    severity=Severity.WARNING,
+                    message="The container entry is not a mapping and cannot be inspected.",
+                    location=FindingLocation(
+                        document_index=index, resource_kind=kind, resource_name=name, path=base_path
+                    ),
+                    suggestion="Provide the container as a YAML mapping.",
+                )
+            ]
+
+        findings: list[Finding] = []
+        raw_name = container.get("name")
+        label = raw_name if isinstance(raw_name, str) and raw_name else "<unnamed>"
+        role = "Init container" if is_init else "Container"
+
+        def add(code: str, severity: Severity, message: str, path: str, suggestion: str) -> None:
+            findings.append(
+                Finding(
+                    code=code,
+                    severity=severity,
+                    message=message,
+                    location=FindingLocation(
+                        document_index=index, resource_kind=kind, resource_name=name, path=path
+                    ),
+                    suggestion=suggestion,
+                )
+            )
+
+        # --- image ---
+        image = container.get("image")
+        if not isinstance(image, str) or not image.strip():
+            add(
+                "K8S_IMAGE_MISSING",
+                Severity.WARNING,
+                f"{role} '{label}' has no image.",
+                f"{base_path}.image",
+                "Set an explicit image reference.",
+            )
+        elif "@" not in image:
+            last_segment = image.rsplit("/", 1)[-1]
+            if ":" not in last_segment:
+                add(
+                    "K8S_IMAGE_TAG_MISSING",
+                    Severity.WARNING,
+                    f"{role} '{label}' uses image '{image}' without a tag.",
+                    f"{base_path}.image",
+                    "Pin an explicit tag or a digest.",
+                )
+            elif last_segment.rsplit(":", 1)[1] == "latest":
+                add(
+                    "K8S_IMAGE_TAG_LATEST",
+                    Severity.WARNING,
+                    f"{role} '{label}' uses image '{image}' with the 'latest' tag.",
+                    f"{base_path}.image",
+                    "Pin a specific version or a digest instead of 'latest'.",
+                )
+
+        # --- resources ---
+        resources = container.get("resources")
+        resources = resources if isinstance(resources, dict) else {}
+        if not resources.get("requests"):
+            add(
+                "K8S_CONTAINER_MISSING_REQUESTS",
+                Severity.WARNING,
+                f"{role} '{label}' declares no resource requests.",
+                f"{base_path}.resources.requests",
+                "Declare CPU and memory requests.",
+            )
+        if not resources.get("limits"):
+            add(
+                "K8S_CONTAINER_MISSING_LIMITS",
+                Severity.WARNING,
+                f"{role} '{label}' declares no resource limits.",
+                f"{base_path}.resources.limits",
+                "Declare CPU and memory limits.",
+            )
+
+        # --- probes: regular containers only, never init containers ---
+        if not is_init:
+            if not container.get("readinessProbe"):
+                add(
+                    "K8S_MISSING_READINESS_PROBE",
+                    Severity.WARNING,
+                    f"Container '{label}' has no readinessProbe.",
+                    f"{base_path}.readinessProbe",
+                    "Add a readinessProbe so traffic only reaches ready pods.",
+                )
+            if not container.get("livenessProbe"):
+                add(
+                    "K8S_MISSING_LIVENESS_PROBE",
+                    Severity.WARNING,
+                    f"Container '{label}' has no livenessProbe.",
+                    f"{base_path}.livenessProbe",
+                    "Add a livenessProbe so a stuck process is restarted.",
+                )
+
+        # --- security context ---
+        security = container.get("securityContext")
+        security = security if isinstance(security, dict) else {}
+
+        if security.get("privileged") is True:
+            add(
+                "K8S_PRIVILEGED_CONTAINER",
+                Severity.ERROR,
+                f"{role} '{label}' is configured as privileged.",
+                f"{base_path}.securityContext.privileged",
+                "Disable privileged unless it is explicitly required.",
+            )
+
+        escalation = security.get("allowPrivilegeEscalation")
+        if escalation is True:
+            add(
+                "K8S_ALLOW_PRIVILEGE_ESCALATION_ENABLED",
+                Severity.ERROR,
+                f"{role} '{label}' explicitly allows privilege escalation.",
+                f"{base_path}.securityContext.allowPrivilegeEscalation",
+                "Set allowPrivilegeEscalation: false.",
+            )
+        elif escalation is not False:
+            add(
+                "K8S_ALLOW_PRIVILEGE_ESCALATION_NOT_DISABLED",
+                Severity.WARNING,
+                f"{role} '{label}' does not explicitly disable privilege escalation.",
+                f"{base_path}.securityContext.allowPrivilegeEscalation",
+                "Set allowPrivilegeEscalation: false.",
+            )
+
+        if not pod_run_as_non_root and security.get("runAsNonRoot") is not True:
+            add(
+                "K8S_RUN_AS_NON_ROOT_NOT_SET",
+                Severity.WARNING,
+                f"{role} '{label}' does not explicitly require non-root execution.",
+                f"{base_path}.securityContext.runAsNonRoot",
+                "Set runAsNonRoot: true at pod or container level.",
+            )
+
+        return findings
+
+
+TOOL = K8sManifestInspectTool()
