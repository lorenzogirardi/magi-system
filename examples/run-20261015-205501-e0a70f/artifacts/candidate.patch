+"""Unit tests for the k8s.manifest.inspect tool (framework-independent)."""
+
+import pytest
+
+from app.toolbox.base import Outcome, ToolLimitExceeded, ToolboxLimits
+from app.toolbox.tools.k8s_manifest_inspect import FINDINGS_LIMIT_CODE, TOOL, K8sManifestInspectInput
+
+
+def _limits(**overrides) -> ToolboxLimits:
+    base = dict(
+        max_input_bytes=262_144,
+        max_yaml_documents=50,
+        max_yaml_depth=32,
+        max_findings=200,
+        max_diff_context_lines=10,
+    )
+    base.update(overrides)
+    return ToolboxLimits(**base)
+
+
+def _run(manifest: str, **overrides):
+    return TOOL.execute(K8sManifestInspectInput(manifest=manifest), _limits(**overrides))
+
+
+def _codes(result) -> set[str]:
+    return {f.code for f in result.findings}
+
+
+GOOD_DEPLOYMENT = """
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: good
+spec:
+  template:
+    spec:
+      securityContext:
+        runAsNonRoot: true
+      containers:
+        - name: app
+          image: nginx:1.27.0
+          resources:
+            requests:
+              cpu: 100m
+            limits:
+              cpu: 200m
+          readinessProbe:
+            httpGet:
+              path: /healthz
+              port: 80
+          livenessProbe:
+            httpGet:
+              path: /healthz
+              port: 80
+          securityContext:
+            allowPrivilegeEscalation: false
+"""
+
+
+def test_clean_deployment_passes():
+    result = _run(GOOD_DEPLOYMENT)
+    assert result.outcome is Outcome.PASS
+    assert result.findings == []
+    assert result.output["resources_inspected"] == 1
+
+
+def test_multi_document_manifest_is_inspected():
+    manifest = GOOD_DEPLOYMENT + "\n---\n" + GOOD_DEPLOYMENT.replace("name: good", "name: good2")
+    result = _run(manifest)
+    assert result.output["documents"] == 2
+    assert result.output["resources_inspected"] == 2
+
+
+def test_empty_documents_are_skipped():
+    # PyYAML yields one document per '---' marker: the leading '---\n---\n'
+    # produces a single empty (None) document followed by the Deployment, so
+    # the stream holds 2 documents and only 1 is inspected.
+    manifest = "---\n---\n" + GOOD_DEPLOYMENT
+    result = _run(manifest)
+    assert result.output["documents"] == 2
+    assert result.output["resources_inspected"] == 1
+
+
+def test_unsupported_kind_is_reported_as_info():
+    manifest = "apiVersion: v1\nkind: Service\nmetadata:\n  name: svc\n"
+    result = _run(manifest)
+    assert "K8S_UNSUPPORTED_KIND" in _codes(result)
+    assert result.outcome is Outcome.PASS
+
+
+def test_missing_kind_is_reported():
+    result = _run("apiVersion: v1\nmetadata:\n  name: x\n")
+    assert "K8S_MISSING_KIND" in _codes(result)
+
+
+def test_unexpected_structure_is_reported():
+    manifest = "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: x\nspec: not-a-mapping\n"
+    result = _run(manifest)
+    assert "K8S_MISSING_POD_SPEC" in _codes(result)
+
+
+def test_non_mapping_document_is_reported():
+    result = _run("- just\n- a\n- list\n")
+    assert "K8S_DOCUMENT_NOT_A_MAPPING" in _codes(result)
+
+
+def test_missing_requests_and_limits_are_reported():
+    manifest = """
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: x
+spec:
+  template:
+    spec:
+      containers:
+        - name: app
+          image: nginx:1.27.0
+"""
+    codes = _codes(_run(manifest))
+    assert "K8S_CONTAINER_MISSING_REQUESTS" in codes
+    assert "K8S_CONTAINER_MISSING_LIMITS" in codes
+
+
+def test_missing_probes_are_reported():
+    manifest = """
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: x
+spec:
+  template:
+    spec:
+      containers:
+        - name: app
+          image: nginx:1.27.0
+"""
+    codes = _codes(_run(manifest))
+    assert "K8S_MISSING_READINESS_PROBE" in codes
+    assert "K8S_MISSING_LIVENESS_PROBE" in codes
+
+
+def test_image_without_tag_is_reported():
+    manifest = GOOD_DEPLOYMENT.replace("nginx:1.27.0", "nginx")
+    assert "K8S_IMAGE_TAG_MISSING" in _codes(_run(manifest))
+
+
+def test_image_with_latest_tag_is_reported():
+    manifest = GOOD_DEPLOYMENT.replace("nginx:1.27.0", "nginx:latest")
+    assert "K8S_IMAGE_TAG_LATEST" in _codes(_run(manifest))
+
+
+def test_image_by_digest_is_accepted():
+    manifest = GOOD_DEPLOYMENT.replace(
+        "nginx:1.27.0", "nginx@sha256:" + "a" * 64
+    )
+    codes = _codes(_run(manifest))
+    assert "K8S_IMAGE_TAG_MISSING" not in codes
+    assert "K8S_IMAGE_TAG_LATEST" not in codes
+
+
+def test_privileged_container_is_an_error():
+    manifest = GOOD_DEPLOYMENT.replace(
+        "allowPrivilegeEscalation: false", "privileged: true"
+    )
+    result = _run(manifest)
+    assert "K8S_PRIVILEGED_CONTAINER" in _codes(result)
+    assert result.outcome is Outcome.FAIL
+
+
+def test_allow_privilege_escalation_true_is_an_error():
+    manifest = GOOD_DEPLOYMENT.replace(
+        "allowPrivilegeEscalation: false", "allowPrivilegeEscalation: true"
+    )
+    assert "K8S_ALLOW_PRIVILEGE_ESCALATION_ENABLED" in _codes(_run(manifest))
+
+
+def test_allow_privilege_escalation_absent_is_a_warning():
+    manifest = GOOD_DEPLOYMENT.replace("          securityContext:\n            allowPrivilegeEscalation: false\n", "")
+    assert "K8S_ALLOW_PRIVILEGE_ESCALATION_NOT_DISABLED" in _codes(_run(manifest))
+
+
+def test_run_as_non_root_at_pod_level_satisfies_the_check():
+    manifest = GOOD_DEPLOYMENT.replace("          securityContext:\n            allowPrivilegeEscalation: false\n", "")
+    assert "K8S_RUN_AS_NON_ROOT_NOT_SET" not in _codes(_run(manifest))
+
+
+def test_run_as_non_root_absent_is_reported():
+    manifest = GOOD_DEPLOYMENT.replace("      securityContext:\n        runAsNonRoot: true\n", "")
+    assert "K8S_RUN_AS_NON_ROOT_NOT_SET" in _codes(_run(manifest))
+
+
+def test_init_containers_do_not_receive_probe_findings():
+    manifest = """
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: x
+spec:
+  template:
+    spec:
+      securityContext:
+        runAsNonRoot: true
+      initContainers:
+        - name: init
+          image: busybox:1.36.0
+          resources:
+            requests:
+              cpu: 10m
+            limits:
+              cpu: 20m
+          securityContext:
+            allowPrivilegeEscalation: false
+      containers:
+        - name: app
+          image: nginx:1.27.0
+          resources:
+            requests:
+              cpu: 100m
+            limits:
+              cpu: 200m
+          readinessProbe:
+            httpGet:
+              path: /healthz
+              port: 80
+          livenessProbe:
+            httpGet:
+              path: /healthz
+              port: 80
+          securityContext:
+            allowPrivilegeEscalation: false
+"""
+    result = _run(manifest)
+    init_findings = [f for f in result.findings if f.location.path and "initContainers" in f.location.path]
+    assert init_findings == []
+    assert result.outcome is Outcome.PASS
+
+
+def test_init_container_security_is_still_checked():
+    manifest = """
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: x
+spec:
+  template:
+    spec:
+      securityContext:
+        runAsNonRoot: true
+      initContainers:
+        - name: init
+          image: busybox:1.36.0
+          securityContext:
+            privileged: true
+      containers:
+        - name: app
+          image: nginx:1.27.0
+"""
+    result = _run(manifest)
+    privileged = [f for f in result.findings if f.code == "K8S_PRIVILEGED_CONTAINER"]
+    assert len(privileged) == 1
+    assert "initContainers" in privileged[0].location.path
+
+
+def test_statefulset_and_daemonset_are_supported():
+    for kind in ("StatefulSet", "DaemonSet"):
+        manifest = GOOD_DEPLOYMENT.replace("kind: Deployment", f"kind: {kind}")
+        result = _run(manifest)
+        assert result.output["resources_inspected"] == 1
+        assert "K8S_UNSUPPORTED_KIND" not in _codes(result)
+
+
+def test_unsafe_yaml_tag_is_rejected():
+    manifest = "!!python/object/apply:os.system ['echo hi']"
+    result = _run(manifest)
+    assert result.outcome is Outcome.FAIL
+    assert "K8S_YAML_INVALID" in _codes(result)
+
+
+def test_yaml_alias_is_rejected():
+    manifest = "a: &x [1,2]\nb: *x\n"
+    result = _run(manifest)
+    assert result.outcome is Outcome.FAIL
+    assert "K8S_YAML_INVALID" in _codes(result)
+
+
+def test_invalid_yaml_is_a_negative_analysis_result():
+    result = _run("kind: [unclosed\n")
+    assert result.outcome is Outcome.FAIL
+    assert result.output["valid_yaml"] is False
+
+
+def test_document_count_limit_is_enforced():
+    manifest = "---\n".join([GOOD_DEPLOYMENT] * 3)
+    with pytest.raises(ToolLimitExceeded) as exc:
+        _run(manifest, max_yaml_documents=2)
+    assert exc.value.limit == "max_yaml_documents"
+
+
+def test_depth_limit_is_enforced():
+    manifest = "a:\n  b:\n    c:\n      d: 1\n"
+    with pytest.raises(ToolLimitExceeded) as exc:
+        _run(manifest, max_yaml_depth=2)
+    assert exc.value.limit == "max_yaml_depth"
+
+
+def test_findings_limit_is_reported_not_truncated_silently():
+    manifest = """
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: x
+spec:
+  template:
+    spec:
+      containers:
+        - name: a
+          image: nginx
+        - name: b
+          image: nginx
+        - name: c
+          image: nginx
+"""
+    result = _run(manifest, max_findings=3)
+    assert result.outcome is Outcome.ERROR
+    assert result.output["limit_exceeded"] is True
+    assert result.findings[-1].code == FINDINGS_LIMIT_CODE
+    assert len(result.findings) == 3
+
+
+def test_oversized_manifest_is_rejected():
+    with pytest.raises(ToolLimitExceeded) as exc:
+        _run("x" * 100, max_input_bytes=10)
+    assert exc.value.limit == "max_input_bytes"
+
+
+def test_output_is_deterministic():
+    first = _run(GOOD_DEPLOYMENT)
+    second = _run(GOOD_DEPLOYMENT)
+    assert first.outcome == second.outcome
+    assert first.output == second.output
+    assert first.findings == second.findings
+
+
+def test_findings_are_deterministic_for_a_dirty_manifest():
+    manifest = GOOD_DEPLOYMENT.replace("nginx:1.27.0", "nginx:latest")
+    first = _run(manifest)
+    second = _run(manifest)
+    assert first.findings == second.findings
