+"""API tests for the Dev/SRE Toolbox router."""
+
+import pytest
+
+from app.toolbox import registry
+from app.toolbox.tools.json_validate import JsonValidateInput
+
+
+@pytest.mark.anyio
+async def test_catalogue_requires_auth(client):
+    resp = await client.get("/api/toolbox/tools")
+    assert resp.status_code == 401
+
+
+@pytest.mark.anyio
+async def test_catalogue_lists_the_three_tools(client, auth_headers):
+    resp = await client.get("/api/toolbox/tools", headers=auth_headers)
+    assert resp.status_code == 200
+    names = [t["name"] for t in resp.json()["tools"]]
+    assert names == ["json.validate", "k8s.manifest.inspect", "text.diff"]
+    for tool in resp.json()["tools"]:
+        assert tool["version"] == "1.0.0"
+        assert tool["description"]
+        assert isinstance(tool["input_schema"], dict)
+
+
+@pytest.mark.anyio
+async def test_run_requires_auth(client):
+    resp = await client.post("/api/toolbox/runs", json={"tool": "json.validate", "input": {"text": "1"}})
+    assert resp.status_code == 401
+
+
+@pytest.mark.anyio
+async def test_run_with_wrong_credentials_is_rejected(client):
+    import base64
+
+    bad = base64.b64encode(b"admin:wrong").decode()
+    resp = await client.post(
+        "/api/toolbox/runs",
+        json={"tool": "json.validate", "input": {"text": "1"}},
+        headers={"Authorization": f"Basic {bad}"},
+    )
+    assert resp.status_code == 401
+
+
+@pytest.mark.anyio
+async def test_valid_run_returns_the_uniform_schema(client, auth_headers):
+    resp = await client.post(
+        "/api/toolbox/runs",
+        json={"tool": "json.validate", "input": {"text": '{"a": 1}'}},
+        headers=auth_headers,
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["tool"] == "json.validate"
+    assert body["tool_version"] == "1.0.0"
+    assert body["status"] == "completed"
+    assert body["outcome"] == "pass"
+    assert body["summary"] == {"info": 0, "warning": 0, "error": 0}
+    assert body["findings"] == []
+    assert body["output"]["value"] == {"a": 1}
+    assert isinstance(body["run_id"], str) and body["run_id"]
+    assert isinstance(body["duration_ms"], int)
+
+
+@pytest.mark.anyio
+async def test_finding_is_not_an_http_error(client, auth_headers):
+    resp = await client.post(
+        "/api/toolbox/runs",
+        json={"tool": "json.validate", "input": {"text": "{"}},
+        headers=auth_headers,
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["outcome"] == "fail"
+    assert body["summary"]["error"] == 1
+    assert body["findings"][0]["code"] == "JSON_INVALID"
+
+
+@pytest.mark.anyio
+async def test_unknown_tool_returns_404(client, auth_headers):
+    resp = await client.post(
+        "/api/toolbox/runs",
+        json={"tool": "does.not.exist", "input": {}},
+        headers=auth_headers,
+    )
+    assert resp.status_code == 404
+    assert resp.json() == {"error": "Not found"}
+
+
+@pytest.mark.anyio
+async def test_malformed_request_returns_422(client, auth_headers):
+    resp = await client.post("/api/toolbox/runs", json={"input": {}}, headers=auth_headers)
+    assert resp.status_code == 422
+
+
+@pytest.mark.anyio
+async def test_invalid_tool_input_returns_422(client, auth_headers):
+    resp = await client.post(
+        "/api/toolbox/runs",
+        json={"tool": "json.validate", "input": {"wrong": 1}},
+        headers=auth_headers,
+    )
+    assert resp.status_code == 422
+
+
+@pytest.mark.anyio
+async def test_over_limit_input_returns_413(client, auth_headers):
+    resp = await client.post(
+        "/api/toolbox/runs",
+        json={"tool": "json.validate", "input": {"text": "x" * 300_000}},
+        headers=auth_headers,
+    )
+    assert resp.status_code == 413
+    assert "exceeds" in str(resp.json()["detail"])
+
+
+@pytest.mark.anyio
+async def test_internal_error_is_sanitized(client, auth_headers, monkeypatch):
+    class _Boom:
+        name = "json.validate"
+        version = "1.0.0"
+        description = "boom"
+        input_model = JsonValidateInput
+
+        def execute(self, params, limits):
+            raise RuntimeError("secret internal detail")
+
+    monkeypatch.setattr(registry, "get_tool", lambda name: _Boom())
+
+    resp = await client.post(
+        "/api/toolbox/runs",
+        json={"tool": "json.validate", "input": {"text": "1"}},
+        headers=auth_headers,
+    )
+    assert resp.status_code == 500
+    body = resp.text
+    assert "secret internal detail" not in body
+    assert "Traceback" not in body
+    assert "RuntimeError" not in body
+
+
+@pytest.mark.anyio
+async def test_openapi_exposes_both_toolbox_routes(client):
+    resp = await client.get("/api/openapi.json")
+    assert resp.status_code == 200
+    paths = resp.json()["paths"]
+    assert "/api/toolbox/tools" in paths
+    assert "/api/toolbox/runs" in paths
+    assert "get" in paths["/api/toolbox/tools"]
+    assert "post" in paths["/api/toolbox/runs"]
+
+
+@pytest.mark.anyio
+async def test_determinism_excluding_run_id_and_duration(client, auth_headers):
+    payload = {"tool": "k8s.manifest.inspect", "input": {"manifest": "kind: Service\nmetadata:\n  name: s\n"}}
+    first = (await client.post("/api/toolbox/runs", json=payload, headers=auth_headers)).json()
+    second = (await client.post("/api/toolbox/runs", json=payload, headers=auth_headers)).json()
+    for body in (first, second):
+        body.pop("run_id")
+        body.pop("duration_ms")
+    assert first == second
