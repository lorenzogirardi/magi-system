new file mode 100644
index 0000000..f998ae4
--- /dev/null
+++ b/app/toolbox/base.py
@@ -0,0 +1,146 @@
+"""Framework-independent primitives for the Dev/SRE Toolbox.
+
+Nothing in this module imports FastAPI: the analysis layer must stay testable
+on its own and reusable outside the HTTP layer.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Any, Protocol, runtime_checkable
+
+from pydantic import BaseModel
+
+
+class Severity(str, Enum):
+    """Severity of a single finding."""
+
+    INFO = "info"
+    WARNING = "warning"
+    ERROR = "error"
+
+
+class Outcome(str, Enum):
+    """Outcome of the analysis performed by a tool.
+
+    PASS  -> the tool found nothing to report.
+    FAIL  -> the tool found something to report. A finding is never an HTTP error.
+    ERROR -> the analysis could not be completed as requested (e.g. a limit was hit).
+    """
+
+    PASS = "pass"
+    FAIL = "fail"
+    ERROR = "error"
+
+
+class ExecutionStatus(str, Enum):
+    """Execution status of the run itself, kept distinct from the analysis outcome."""
+
+    COMPLETED = "completed"
+    FAILED = "failed"
+
+
+@dataclass(frozen=True)
+class FindingLocation:
+    """Where a finding was observed. Every field is optional."""
+
+    document_index: int | None = None
+    resource_kind: str | None = None
+    resource_name: str | None = None
+    path: str | None = None
+
+
+@dataclass(frozen=True)
+class Finding:
+    """A single observation produced by a tool."""
+
+    code: str
+    severity: Severity
+    message: str
+    location: FindingLocation = field(default_factory=FindingLocation)
+    suggestion: str | None = None
+
+
+@dataclass(frozen=True)
+class FindingSummary:
+    """Number of findings per severity."""
+
+    info: int = 0
+    warning: int = 0
+    error: int = 0
+
+
+def summarize(findings: list[Finding]) -> FindingSummary:
+    """Count findings by severity."""
+    return FindingSummary(
+        info=sum(1 for f in findings if f.severity is Severity.INFO),
+        warning=sum(1 for f in findings if f.severity is Severity.WARNING),
+        error=sum(1 for f in findings if f.severity is Severity.ERROR),
+    )
+
+
+@dataclass
+class ToolResult:
+    """Uniform result returned by every tool."""
+
+    outcome: Outcome
+    findings: list[Finding] = field(default_factory=list)
+    output: dict[str, Any] = field(default_factory=dict)
+
+    @property
+    def summary(self) -> FindingSummary:
+        return summarize(self.findings)
+
+
+@dataclass(frozen=True)
+class ToolboxLimits:
+    """Configurable bounds applied to every tool invocation."""
+
+    max_input_bytes: int
+    max_yaml_documents: int
+    max_yaml_depth: int
+    max_findings: int
+    max_diff_context_lines: int
+
+
+class ToolError(Exception):
+    """Base class for controlled tool failures."""
+
+
+class ToolInputError(ToolError):
+    """The input is structurally wrong for this tool (mapped to HTTP 422)."""
+
+
+class ToolLimitExceeded(ToolError):
+    """A configured limit was exceeded (mapped to HTTP 413). No silent truncation."""
+
+    def __init__(self, message: str, *, limit: str, value: int) -> None:
+        super().__init__(message)
+        self.limit = limit
+        self.value = value
+
+
+def check_text_size(text: str, limits: ToolboxLimits, *, field_name: str) -> None:
+    """Reject a text input larger than the configured maximum, with a specific message."""
+    size = len(text.encode("utf-8"))
+    if size > limits.max_input_bytes:
+        raise ToolLimitExceeded(
+            f"{field_name} is {size} bytes, which exceeds the configured maximum of "
+            f"{limits.max_input_bytes} bytes",
+            limit="max_input_bytes",
+            value=limits.max_input_bytes,
+        )
+
+
+@runtime_checkable
+class Tool(Protocol):
+    """Common contract every toolbox tool implements."""
+
+    name: str
+    version: str
+    description: str
+    input_model: type[BaseModel]
+
+    def execute(self, params: BaseModel, limits: ToolboxLimits) -> ToolResult:
+        ...
