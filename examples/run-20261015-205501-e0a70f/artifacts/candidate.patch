@@ -0,0 +1,179 @@
+"""Dev/SRE Toolbox router - tool catalogue and synchronous tool execution.
+
+Reuses the application's existing Basic Auth dependency, loguru structured
+logging, Prometheus route instrumentation and OpenTelemetry FastAPI
+instrumentation. CPU-bound parsing is offloaded with the same
+``loop.run_in_executor`` pattern used by ``/api/fib/{x}``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import time
+import uuid
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from loguru import logger
+from pydantic import ValidationError
+
+from app.auth import verify_credentials
+from app.config import get_settings
+from app.models.toolbox import (
+    Finding,
+    FindingLocation,
+    FindingSummary,
+    ToolInfo,
+    ToolListResponse,
+    ToolRunRequest,
+    ToolRunResponse,
+)
+from app.toolbox import registry
+from app.toolbox.base import (
+    ExecutionStatus,
+    ToolInputError,
+    ToolLimitExceeded,
+    ToolResult,
+    ToolboxLimits,
+)
+
+router = APIRouter(
+    prefix="/api/toolbox",
+    tags=["Toolbox"],
+    dependencies=[Depends(verify_credentials)],
+)
+
+
+def _limits() -> ToolboxLimits:
+    """Build the per-invocation limits from the application settings."""
+    settings = get_settings()
+    return ToolboxLimits(
+        max_input_bytes=settings.toolbox_max_input_bytes,
+        max_yaml_documents=settings.toolbox_max_yaml_documents,
+        max_yaml_depth=settings.toolbox_max_yaml_depth,
+        max_findings=settings.toolbox_max_findings,
+        max_diff_context_lines=settings.toolbox_max_diff_context_lines,
+    )
+
+
+def _to_finding(finding) -> Finding:
+    """Convert a framework-independent dataclass finding into its API model."""
+    return Finding(
+        code=finding.code,
+        severity=finding.severity.value,
+        message=finding.message,
+        location=FindingLocation(
+            document_index=finding.location.document_index,
+            resource_kind=finding.location.resource_kind,
+            resource_name=finding.location.resource_name,
+            path=finding.location.path,
+        ),
+        suggestion=finding.suggestion,
+    )
+
+
+def _to_response(run_id: str, tool, result: ToolResult, duration_ms: int) -> ToolRunResponse:
+    summary = result.summary
+    return ToolRunResponse(
+        run_id=run_id,
+        tool=tool.name,
+        tool_version=tool.version,
+        status=ExecutionStatus.COMPLETED.value,
+        outcome=result.outcome.value,
+        summary=FindingSummary(info=summary.info, warning=summary.warning, error=summary.error),
+        findings=[_to_finding(f) for f in result.findings],
+        output=result.output,
+        duration_ms=duration_ms,
+    )
+
+
+@router.get("/tools", response_model=ToolListResponse, summary="List the available toolbox tools")
+async def list_tools() -> ToolListResponse:
+    """Return identifier, description, version and input schema of every tool."""
+    return ToolListResponse(
+        tools=[
+            ToolInfo(
+                name=tool.name,
+                description=tool.description,
+                version=tool.version,
+                input_schema=tool.input_model.model_json_schema(),
+            )
+            for tool in registry.list_tools()
+        ]
+    )
+
+
+@router.post("/runs", response_model=ToolRunResponse, summary="Run one toolbox tool")
+async def run_tool(payload: ToolRunRequest, request: Request) -> ToolRunResponse:
+    """Execute one of the available tools synchronously and return a uniform result."""
+    run_id = str(uuid.uuid4())
+    settings = get_settings()
+
+    content_length = request.headers.get("content-length")
+    if content_length and content_length.isdigit() and int(content_length) > settings.toolbox_max_request_bytes:
+        raise HTTPException(
+            status_code=413,
+            detail=(
+                f"Request body is {content_length} bytes, which exceeds the configured maximum of "
+                f"{settings.toolbox_max_request_bytes} bytes"
+            ),
+        )
+
+    tool = registry.get_tool(payload.tool)
+    if tool is None:
+        raise HTTPException(status_code=404, detail="Unknown tool")
+
+    try:
+        params = tool.input_model.model_validate(payload.input)
+    except ValidationError as exc:
+        raise HTTPException(
+            status_code=422,
+            detail={
+                "error": "Invalid tool input",
+                "tool": tool.name,
+                "errors": [
+                    {"loc": list(err["loc"]), "msg": err["msg"], "type": err["type"]}
+                    for err in exc.errors()
+                ],
+            },
+        ) from exc
+
+    limits = _limits()
+    loop = asyncio.get_running_loop()
+    start = time.monotonic()
+
+    try:
+        result = await loop.run_in_executor(None, tool.execute, params, limits)
+    except ToolLimitExceeded as exc:
+        duration_ms = int((time.monotonic() - start) * 1000)
+        logger.info(
+            "toolbox run | run_id={} tool={} status={} outcome={} duration_ms={}",
+            run_id,
+            tool.name,
+            ExecutionStatus.FAILED.value,
+            "limit_exceeded",
+            duration_ms,
+        )
+        raise HTTPException(status_code=413, detail=str(exc)) from exc
+    except ToolInputError as exc:
+        raise HTTPException(status_code=422, detail=str(exc)) from exc
+    except Exception:
+        duration_ms = int((time.monotonic() - start) * 1000)
+        logger.exception(
+            "toolbox run failed | run_id={} tool={} status={} duration_ms={}",
+            run_id,
+            tool.name,
+            ExecutionStatus.FAILED.value,
+            duration_ms,
+        )
+        raise HTTPException(status_code=500, detail="Internal server error") from None
+
+    duration_ms = int((time.monotonic() - start) * 1000)
+    logger.info(
+        "toolbox run | run_id={} tool={} status={} outcome={} duration_ms={}",
+        run_id,
+        tool.name,
+        ExecutionStatus.COMPLETED.value,
+        result.outcome.value,
+        duration_ms,
+    )
+    return _to_response(run_id, tool, result, duration_ms)
