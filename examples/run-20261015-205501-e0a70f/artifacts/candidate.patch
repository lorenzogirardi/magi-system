+"""Regression tests: the existing endpoints keep working with the toolbox mounted."""
+
+import pytest
+
+
+@pytest.mark.anyio
+async def test_contexts_still_work(client):
+    resp = await client.get("/api/contexts")
+    assert resp.status_code == 200
+    assert resp.json() == []
+
+
+@pytest.mark.anyio
+async def test_fibonacci_still_works(client):
+    resp = await client.get("/api/fib/10")
+    assert resp.status_code == 200
+    assert resp.json()["result"] == "55"
+
+
+@pytest.mark.anyio
+async def test_health_still_works(client):
+    resp = await client.get("/api/mgmt/health")
+    assert resp.status_code in (200, 503)
+
+
+@pytest.mark.anyio
+async def test_debug_ping_still_requires_auth(client):
+    resp = await client.get("/api/debug/ping", params={"host": "localhost"})
+    assert resp.status_code == 401
+
+
+@pytest.mark.anyio
+async def test_400_envelope_is_unchanged(client):
+    resp = await client.get("/api/fib/5001")
+    assert resp.status_code == 400
+    assert resp.json() == {"error": "Bad request"}
+
+
+@pytest.mark.anyio
+async def test_mappings_still_lists_routes(client):
+    resp = await client.get("/api/mgmt/mappings")
+    assert resp.status_code == 200
+    paths = {m["path"] for m in resp.json()["mappings"]}
+    assert "/api/contexts" in paths
+    assert "/api/toolbox/tools" in paths
