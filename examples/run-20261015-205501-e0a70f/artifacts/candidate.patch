+"""Pydantic models for the Dev/SRE Toolbox API (request, result, finding)."""
+
+from typing import Any, Literal
+
+from pydantic import BaseModel, Field
+
+
+class FindingLocation(BaseModel):
+    """Where a finding was observed. Every field is optional."""
+
+    document_index: int | None = None
+    resource_kind: str | None = None
+    resource_name: str | None = None
+    path: str | None = None
+
+
+class Finding(BaseModel):
+    """A single observation produced by a tool. A finding is never an HTTP error."""
+
+    code: str
+    severity: Literal["info", "warning", "error"]
+    message: str
+    location: FindingLocation = Field(default_factory=FindingLocation)
+    suggestion: str | None = None
+
+
+class FindingSummary(BaseModel):
+    """Number of findings per severity."""
+
+    info: int = 0
+    warning: int = 0
+    error: int = 0
+
+
+class ToolInfo(BaseModel):
+    """Catalogue entry for one tool."""
+
+    name: str
+    description: str
+    version: str
+    input_schema: dict[str, Any]
+
+
+class ToolListResponse(BaseModel):
+    """Response of GET /api/toolbox/tools."""
+
+    tools: list[ToolInfo]
+
+
+class ToolRunRequest(BaseModel):
+    """Request of POST /api/toolbox/runs."""
+
+    tool: str = Field(..., description="Identifier of the tool to run.")
+    input: dict[str, Any] = Field(default_factory=dict, description="Tool-specific input object.")
+
+
+class ToolRunResponse(BaseModel):
+    """Uniform result returned by POST /api/toolbox/runs.
+
+    ``status`` is the execution status of the run, ``outcome`` is the analysis
+    outcome. They are deliberately distinct.
+    """
+
+    run_id: str
+    tool: str
+    tool_version: str
+    status: Literal["completed", "failed"]
+    outcome: Literal["pass", "fail", "error"]
+    summary: FindingSummary
+    findings: list[Finding]
+    output: dict[str, Any]
+    duration_ms: int
+
+
+class ToolboxErrorResponse(BaseModel):
+    """Documented error envelope for toolbox failures."""
+
+    detail: Any
