# Environment of the magi-agentcore runtime (set by deploy/agentcore/terraform). Names only:
# no values, no secrets. The OpenRouter key is read from Secrets Manager at start.
# See docs/agentcore/configuration.md for meanings.
AWS_REGION=
MAGI_STORE=dynamodb
MAGI_RUNS_ROOT=/mnt/runs
MAGI_DYNAMODB_RUNS_TABLE=
MAGI_DYNAMODB_CHECKPOINT_TABLE=
MAGI_CHECKPOINT_S3_BUCKET=
MAGI_CHECKPOINT_TTL_SECONDS=
MAGI_OPENROUTER_SECRET_ID=
MAGI_ALLOWED_PROFILES=agentcore
MAGI_ALLOWED_PROVIDERS=openrouter
MAGI_SETTINGS_FILE=
MAGI_CI_IDENTIFIER=
MAGI_EFS_FILE_SYSTEM_ID=
MAGI_EFS_FILE_SYSTEM_ARN=
MAGI_EFS_RUNS_PATH=/magi
MAGI_EFS_POSIX_UID=1000
MAGI_EFS_POSIX_GID=1000
MAGI_CI_TOOLCHAIN_PATH=/usr/local/bin:/usr/bin:/bin
MAGI_CI_SESSION_TIMEOUT_SECONDS=28800
MAGI_EVENTS_STDOUT=1
