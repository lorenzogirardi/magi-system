+"""Unit tests for the json.validate tool."""
+
+import pytest
+
+from app.toolbox.base import ToolLimitExceeded, ToolLimits
+from app.toolbox.tools.json_validate import JsonValidateInput, JsonValidateTool
+
+LIMITS = ToolLimits(
+    max_input_bytes=10000,
+    max_yaml_documents=10,
+    max_yaml_depth=20,
+    max_yaml_aliases=10,
+    max_findings=100,
+    max_diff_context_lines=10,
+)
+
+
+def _run(text, limits=LIMITS):
+    return JsonValidateTool().run(JsonValidateInput(text=text), limits)
+
+
+def test_valid_object():
+    result = _run('{"a": 1, "b": [true, null]}')
+    assert result.findings == []
+    assert result.output["valid"] is True
+    assert result.output["value"] == {"a": 1, "b": [True, None]}
+
+
+def test_valid_scalar():
+    result = _run("42")
+    assert result.output == {"valid": True, "value": 42}
+
+
+def test_invalid_syntax_reports_position():
+    result = _run('{"a": }')
+    assert result.output["valid"] is False
+    assert len(result.findings) == 1
+    finding = result.findings[0]
+    assert finding.code == "JSON_INVALID_SYNTAX"
+    assert finding.severity == "error"
+    assert "line" in finding.location["path"]
+
+
+def test_empty_input():
+    result = _run("   ")
+    assert result.output["valid"] is False
+    assert result.findings[0].code == "JSON_EMPTY_INPUT"
+
+
+def test_size_limit():
+    limits = ToolLimits(
+        max_input_bytes=5,
+        max_yaml_documents=10,
+        max_yaml_depth=20,
+        max_yaml_aliases=10,
+        max_findings=100,
+        max_diff_context_lines=10,
+    )
+    with pytest.raises(ToolLimitExceeded) as exc:
+        _run('{"a": 1}', limits)
+    assert exc.value.limit == "max_input_bytes"
+
+
+def test_deterministic_output():
+    first = _run('{"a": 1}')
+    second = _run('{"a": 1}')
+    assert first.output == second.output
+    assert first.findings == second.findings
