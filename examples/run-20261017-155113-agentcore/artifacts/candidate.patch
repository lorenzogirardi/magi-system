+"""Dev/SRE Toolbox: modular, synchronous, read-only utility catalog.
+
+Public surface:
+
+* ``app.toolbox.base``     — Tool protocol, limits, findings, result contract
+* ``app.toolbox.registry`` — explicit registry of the available tools
+* ``app.toolbox.tools``    — the tool implementations
+
+The package is pure Python: it never imports FastAPI, so every analysis
+function is unit-testable in isolation.
+"""
+
+from app.toolbox.base import (  # noqa: F401
+    Finding,
+    Tool,
+    ToolInputError,
+    ToolLimitExceeded,
+    ToolLimits,
+    ToolResult,
+    outcome_for,
+    summarize,
+)
+from app.toolbox.registry import get_tool, list_tools  # noqa: F401
+
+__all__ = [
+    "Finding",
+    "Tool",
+    "ToolInputError",
+    "ToolLimitExceeded",
+    "ToolLimits",
+    "ToolResult",
+    "outcome_for",
+    "summarize",
+    "get_tool",
+    "list_tools",
+]
