+"""API tests for the Dev/SRE Toolbox endpoints."""
+
+import pytest
+
+from app.toolbox.base import ToolLimits
+from app.toolbox.tools.json_validate import JsonValidateInput
+
+
+@pytest.mark.anyio
+async def test_catalog_requires_auth(client):
+    resp = await client.get("/api/toolbox/tools")
+    assert resp.status_code == 401
+
+
+@pytest.mark.anyio
+async def test_catalog(client, auth_headers):
+    resp = await client.get("/api/toolbox/tools", headers=auth_headers)
+    assert resp.status_code == 200
+    body = resp.json()
+    ids = {t["id"] for t in body["tools"]}
+    assert ids == {"json.validate", "text.diff", "k8s.manifest.inspect"}
+    for entry in body["tools"]:
+        assert entry["version"]
+        assert entry["description"]
+        assert entry["input_schema"]["type"] == "object"
+
+
+@pytest.mark.anyio
+async def test_valid_run(client, auth_headers):
+    resp = await client.post(
+        "/api/toolbox/runs",
+        headers=auth_headers,
+        json={"tool": "json.validate", "input": {"text": '{"a": 1}'}},
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["tool"] == "json.validate"
+    assert body["status"] == "completed"
+    assert body["outcome"] == "pass"
+    assert body["summary"] == {"info": 0, "warning": 0, "error": 0}
+    assert body["output"]["value"] == {"a": 1}
+    assert body["run_id"]
+
+
+@pytest.mark.anyio
+async def test_invalid_json_is_not_an_http_error(client, auth_headers):
+    resp = await client.post(
+        "/api/toolbox/runs",
+        headers=auth_headers,
+        json={"tool": "json.validate", "input": {"text": "{"}},
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["outcome"] == "fail"
+    assert body["findings"][0]["code"] == "JSON_INVALID_SYNTAX"
+
+
+@pytest.mark.anyio
+async def test_unknown_tool(client, auth_headers):
+    resp = await client.post(
+        "/api/toolbox/runs",
+        headers=auth_headers,
+        json={"tool": "nope", "input": {}},
+    )
+    assert resp.status_code == 404
+    assert resp.json()["error"] == "Unknown tool"
+
+
+@pytest.mark.anyio
+async def test_malformed_request(client, auth_headers):
+    resp = await client.post("/api/toolbox/runs", headers=auth_headers, json={"input": {}})
+    assert resp.status_code == 422
+
+
+@pytest.mark.anyio
+async def test_tool_input_schema_mismatch(client, auth_headers):
+    resp = await client.post(
+        "/api/toolbox/runs",
+        headers=auth_headers,
+        json={"tool": "json.validate", "input": {"wrong": 1}},
+    )
+    assert resp.status_code == 422
+    assert resp.json()["error"] == "Invalid tool input"
+
+
+@pytest.mark.anyio
+async def test_limit_exceeded(client, auth_headers, monkeypatch):
+    import app.routers.toolbox as tb
+
+    monkeypatch.setattr(
+        tb,
+        "_effective_limits",
+        lambda: ToolLimits(
+            max_input_bytes=5,
+            max_yaml_documents=10,
+            max_yaml_depth=20,
+            max_yaml_aliases=10,
+            max_findings=100,
+            max_diff_context_lines=10,
+        ),
+    )
+    resp = await client.post(
+        "/api/toolbox/runs",
+        headers=auth_headers,
+        json={"tool": "json.validate", "input": {"text": '{"a": 1}'}},
+    )
+    assert resp.status_code == 413
+    assert "max_input_bytes" in resp.json()["detail"]
+
+
+@pytest.mark.anyio
+async def test_internal_error_is_sanitized(client, auth_headers, monkeypatch):
+    import app.routers.toolbox as tb
+
+    class Boom:
+        id = "boom"
+        version = "1.0.0"
+        description = "boom"
+        input_model = JsonValidateInput
+
+        def run(self, payload, limits):
+            raise RuntimeError("secret internal detail")
+
+    monkeypatch.setattr(tb, "get_tool", lambda tool_id: Boom())
+    resp = await client.post(
+        "/api/toolbox/runs",
+        headers=auth_headers,
+        json={"tool": "boom", "input": {"text": "{}"}},
+    )
+    assert resp.status_code == 500
+    assert resp.json()["error"] == "Internal server error"
+    assert "secret internal detail" not in resp.text
+
+
+@pytest.mark.anyio
+async def test_k8s_run_end_to_end(client, auth_headers):
+    manifest = """
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: example
+spec:
+  template:
+    spec:
+      containers:
+        - name: app
+          image: nginx:latest
+          securityContext:
+            privileged: true
+"""
+    resp = await client.post(
+        "/api/toolbox/runs",
+        headers=auth_headers,
+        json={"tool": "k8s.manifest.inspect", "input": {"manifest": manifest}},
+    )
+    assert resp.status_code == 200
+    body = resp.json()
+    assert body["outcome"] == "fail"
+    codes = {f["code"] for f in body["findings"]}
+    assert "K8S_PRIVILEGED_CONTAINER" in codes
+    assert "K8S_IMAGE_LATEST_TAG" in codes
+    assert body["summary"]["error"] >= 1
+
+
+@pytest.mark.anyio
+async def test_existing_endpoints_still_work(client):
+    resp = await client.get("/api/fib/10")
+    assert resp.status_code == 200
+    assert resp.json()["result"] == "55"
