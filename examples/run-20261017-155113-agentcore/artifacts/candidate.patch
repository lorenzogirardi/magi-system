+"""Unit tests for the text.diff tool."""
+
+import pytest
+from pydantic import ValidationError
+
+from app.toolbox.base import ToolLimitExceeded, ToolLimits
+from app.toolbox.tools.text_diff import TextDiffInput, TextDiffTool
+
+LIMITS = ToolLimits(
+    max_input_bytes=10000,
+    max_yaml_documents=10,
+    max_yaml_depth=20,
+    max_yaml_aliases=10,
+    max_findings=100,
+    max_diff_context_lines=10,
+)
+
+
+def _run(left, right, context_lines=3, limits=LIMITS):
+    return TextDiffTool().run(
+        TextDiffInput(left=left, right=right, context_lines=context_lines), limits
+    )
+
+
+def test_identical_inputs():
+    result = _run("a\nb\n", "a\nb\n")
+    assert result.output["identical"] is True
+    assert result.output["diff"] == ""
+    assert result.findings == []
+
+
+def test_different_inputs():
+    result = _run("a\nb\n", "a\nc\n")
+    assert result.output["identical"] is False
+    assert "-b" in result.output["diff"]
+    assert "+c" in result.output["diff"]
+    assert result.findings[0].code == "TEXT_DIFF_DIFFERENT"
+    assert result.findings[0].severity == "info"
+
+
+def test_empty_strings():
+    result = _run("", "")
+    assert result.output["identical"] is True
+
+
